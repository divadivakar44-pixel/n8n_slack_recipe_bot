      "id": "afdb271c-b6b4-4b0c-863c-81fccc3e44d4",
      "name": "Capture Recipe Name",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        448,
        -576
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.recipe }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a practical cooking assistant inside Slack. The user message is the name of a recipe. List all the products and ingredients needed to make it for 2 people, as a clear bulleted list (one '- ' bullet per line) with approximate quantities. Group by sensible headings written as plain lines like 'Vegetables:' only if the list is long. Keep it short and practical. No cooking instructions. Start with: 'To make <recipe> you'll need:'. If the text is not a recognizable dish or recipe, reply only with a polite one-line request asking the user to rephrase the recipe name."
            }
          ]
        }
      },
      "id": "750654d9-db2f-4d69-8b70-88ace13c469f",
      "name": "Generate Ingredient List",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        912,
        -576
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "options": {}
      },
      "id": "bb4e5ed2-dcca-4fee-aae4-46ff36b6fc45",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        912,
        -352
      ],
      "credentials": {
        "openAiApi": {
          "id": "rnrqlGSjr2wf7EyL",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst ctx = $('Capture Recipe Name').first().json;\nlet answer = String(item.text ?? item.response ?? item.output ?? '').trim();\nif (!answer) {\n  answer = 'Sorry, I could not prepare the ingredient list. Please try another recipe name.';\n}\nanswer = answer\n  .replace(/[*][*](.+?)[*][*]/g, '*$1*')\n  .replace(/^#{1,6}[ ]*(.+)$/gm, '*$1*')\n  .replace(/^[ ]*[-*][ ]+/gm, '• ');\nreturn [{ json: { channel: ctx.channel, slackMessage: answer } }];"
      },
      "id": "2a1dddd9-ad44-4943-9d27-5980d93ba617",
      "name": "Format for Slack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
